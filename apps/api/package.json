{
  "name": "@cmsauto/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "rm -f data/test.sqlite data/test.sqlite-shm data/test.sqlite-wal",
    "test": "DATABASE_PATH=./data/test.sqlite NODE_ENV=test BOOTSTRAP_SUPERADMIN_USERNAME=testadmin BOOTSTRAP_SUPERADMIN_PASSWORD=TestPassword123 BOOTSTRAP_SUPERADMIN_FULL_NAME='Test Admin' vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "@cmsauto/contracts": "workspace:*",
    "better-sqlite3": "12.10.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
